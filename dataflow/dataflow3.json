{
	"name": "dataflow3",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ExistingProduct",
						"type": "DatasetReference"
					},
					"name": "ExistingProducts"
				},
				{
					"dataset": {
						"referenceName": "NewProduct",
						"type": "DatasetReference"
					},
					"name": "NewProducts"
				},
				{
					"dataset": {
						"referenceName": "ExistingProduct",
						"type": "DatasetReference"
					},
					"name": "LookupMaxKeys"
				}
			],
			"sinks": [
				{
					"name": "CachKeys"
				}
			],
			"transformations": [
				{
					"name": "CreateHashKeysNew"
				},
				{
					"name": "CreateHashKeys"
				},
				{
					"name": "FilterForActive"
				},
				{
					"name": "CheckForNewProduct"
				},
				{
					"name": "CheckForExistingProduct"
				},
				{
					"name": "GetProductID"
				},
				{
					"name": "AddDimensionColumns"
				},
				{
					"name": "MarkAsInsert"
				},
				{
					"name": "ObsoleteProduct"
				},
				{
					"name": "MarkAsUpdate"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ProductID as integer,",
				"          Name as string,",
				"          ProductNumber as string,",
				"          Color as string,",
				"          StandardCost as decimal(19,4),",
				"          ListPrice as decimal(19,4),",
				"          Size as string,",
				"          Weight as decimal(8,2),",
				"          ProductCategoryID as integer,",
				"          ProductModelID as integer,",
				"          SellStartDate as timestamp,",
				"          SellEndDate as timestamp,",
				"          DiscontinuedDate as timestamp,",
				"          ThumbNailPhoto as binary,",
				"          ThumbnailPhotoFileName as string,",
				"          rowguid as string,",
				"          ModifiedDate as timestamp,",
				"          EffectiveDate as timestamp,",
				"          Active as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ExistingProducts",
				"source(output(",
				"          Name as string,",
				"          ProductNumber as string,",
				"          Color as string,",
				"          StandardCost as float,",
				"          ListPrice as float",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     inferDriftedColumnTypes: true,",
				"     ignoreNoFilesFound: false) ~> NewProducts",
				"source(output(",
				"          maxkey as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT MAX (ProductID) AS maxkey FROM [SalesLT].[Product]',",
				"     format: 'query') ~> LookupMaxKeys",
				"NewProducts derive(HashKeysNew = md5(Name,ProductNumber,Color,StandardCost,ListPrice)) ~> CreateHashKeysNew",
				"FilterForActive derive(HashKeys = md5(Name,ProductNumber,Color,StandardCost,ListPrice)) ~> CreateHashKeys",
				"ExistingProducts filter(Active == 1) ~> FilterForActive",
				"CreateHashKeysNew, CreateHashKeys exists(NewProducts@ProductNumber == ExistingProducts@ProductNumber && HashKeysNew == HashKeys,",
				"     negate:true,",
				"     broadcast: 'auto')~> CheckForNewProduct",
				"CreateHashKeys, CreateHashKeysNew exists(NewProducts@ProductNumber == ExistingProducts@ProductNumber || HashKeysNew == HashKeys,",
				"     negate:false,",
				"     broadcast: 'left')~> CheckForExistingProduct",
				"CheckForNewProduct keyGenerate(output(ProductID as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> GetProductID",
				"GetProductID derive(ProductID = toInteger(CachKeys#output().maxkey),",
				"          Active = 1,",
				"          EffectiveDate = currentUTC()) ~> AddDimensionColumns",
				"AddDimensionColumns alterRow(insertIf(true())) ~> MarkAsInsert",
				"CheckForExistingProduct derive(Active = 0) ~> ObsoleteProduct",
				"ObsoleteProduct alterRow(updateIf(true())) ~> MarkAsUpdate",
				"MarkAsInsert, MarkAsUpdate union(byName: true)~> union1",
				"LookupMaxKeys sink(validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     store: 'cache',",
				"     format: 'inline',",
				"     output: false,",
				"     saveOrder: 1) ~> CachKeys"
			]
		}
	}
}